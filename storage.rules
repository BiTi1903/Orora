rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Same claim / enabled admin membership as firestore.rules (default database).
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.get('admin', false) == true || (
          firestore.exists(/databases/(default)/documents/adminUsers/$(request.auth.uid)) &&
          firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data.enabled == true
        )
      );
    }
    function isProductImage() {
      // Metadata checks; clients still must upload actual image bytes.
      return request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif|avif)');
    }
    match /{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isProductImage();
      allow delete: if isAdmin();
    }
  }
}
