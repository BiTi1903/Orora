  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "check": "npm test && npm run lint && npm run build && node scripts/check-bundles.mjs",
    "check:production": "node scripts/check-production.mjs",
    "backup:firestore": "node scripts/firestore-backup.mjs",
    "test:ui": "playwright test",
    "test:ui:browsers": "playwright test --config playwright.browsers.config.js",
    "test:rules": "firebase emulators:exec --project demo-orora-security --only firestore,storage --config firebase.emulators.json \"node --test rules-tests/storage.test.mjs rules-tests/restore-drill.mjs\"",
    "deploy:storage": "firebase deploy --config firebase.storage.json --only storage --project ororavn-e6b49"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@vercel/functions": "3.11.1",
    "firebase": "^12.19.0",
    "firebase-admin": "13.10.0",
    "gsap": "^3.15.0",
    "nodemailer": "10.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "read-excel-file": "^9.3.20",
    "vietnam-divisions-js": "3.0.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
