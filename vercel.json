{
  "crons": [{ "path": "/scheduled/mail-review", "schedule": "0 1 * * *" }],
  "rewrites": [
    { "source": "/scheduled/mail-review", "destination": "/api/admin-orders?scheduledReview=1" },
    { "source": "/chinh-sach", "destination": "/index.html" },
    {
      "source": "/api/storefront-shell",
      "destination": "/api/storefront/shell"
    },
    {
      "source": "/api/share-image",
      "destination": "/api/storefront/share-image"
    },
    {
      "source": "/api/sitemap",
      "destination": "/api/storefront/sitemap"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/storefront/sitemap"
    },
    {
      "source": "/tra-cuu-don-hang",
      "destination": "/index.html"
    },
    {
      "source": "/san-pham",
      "destination": "/index.html"
    },
    {
      "source": "/ve-orora",
      "destination": "/index.html"
    },
    {
      "source": "/lien-he",
      "destination": "/index.html"
    },
    {
      "source": "/chinh-sach",
      "destination": "/index.html"
    },
    {
      "source": "/product/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/tra-cuu-don-hang",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/chat.js": {
      "maxDuration": 30
    },
    "api/newsletter.js": {
      "maxDuration": 60
    },
    "api/subscribe.js": {
      "maxDuration": 60
    },
    "api/orders.js": {
      "maxDuration": 60
    },
    "api/admin-orders.js": {
      "maxDuration": 60
    },
    "api/inventory.js": {
      "maxDuration": 60
    },
    "api/analytics.js": {
      "maxDuration": 60
    }
  }
}
