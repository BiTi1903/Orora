{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/san-pham",
      "destination": "/index.html"
    },
    {
      "source": "/ve-orora",
      "destination": "/index.html"
    },
    {
      "source": "/lien-he",
      "destination": "/index.html"
    },
    {
      "source": "/product/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/newsletter.js": {
      "maxDuration": 60
    },
    "api/subscribe.js": {
      "maxDuration": 60
    },
    "api/orders.js": {
      "maxDuration": 60
    },
    "api/admin-orders.js": {
      "maxDuration": 60
    },
    "api/inventory.js": {
      "maxDuration": 60
    }
  }
}
