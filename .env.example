# Frontend Firebase configuration; never put server credentials in VITE_ variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server only. Set secure values in Vercel Environment Variables, not in Git.
# graph keeps the existing transport; set smtp only after SMTP OAuth2 setup.
MS_MAIL_TRANSPORT=graph
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_EMAIL=sales@ororavn.com
FIREBASE_SERVICE_ACCOUNT_JSON=
NEWSLETTER_SITE_ORIGIN=https://ororavn.com
NEWSLETTER_ADMIN_UIDS=
NEWSLETTER_UNSUBSCRIBE_SECRET=
