# Frontend Firebase configuration; never put server credentials in VITE_ variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server only. Set secure values in Vercel Environment Variables, not in Git.
# graph keeps the existing transport; set smtp only after SMTP OAuth2 setup.
MS_MAIL_TRANSPORT=smtp
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_EMAIL=sales@ororavn.com
# Optional inbox for new order and newsletter signup alerts (defaults to MS_SENDER_EMAIL).
STORE_NOTIFICATION_EMAIL=
FIREBASE_SERVICE_ACCOUNT_JSON=
NEWSLETTER_SITE_ORIGIN=https://ororavn.com
NEWSLETTER_ADMIN_UIDS=
NEWSLETTER_UNSUBSCRIBE_SECRET=

# Server-only OpenAI chat. Never use a VITE_ prefix for an AI API key.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
CHAT_SITE_ORIGIN=https://ororavn.com
CHAT_AI_DAILY_LIMIT=250
CHAT_RATE_LIMIT_SALT=
