rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
          ? get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.enabled == true
          : request.auth.token.get('admin', false) == true
      );
    }
    match /adminUsers/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{docId} {
      allow read: if docId in ['home', 'productCategories'] || isAdmin();
      allow write: if isAdmin();
    }
    // Orders, customer data, inventory, mail and logs are server-only.
    match /{document=**} { allow read, write: if false; }
  }
}
